generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

// FR-01, FR-02, FR-22: one account table, separated by role.
model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  name         String
  passwordHash String
  role         Role
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  attempts     ExamAttempt[]
}

model QuestionPool {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  exams     Exam[]
  questions Question[]
}

model Exam {
  id                String         @id @default(cuid())
  title             String
  questionCount     Int
  durationMinutes   Int            @default(60)
  startTime         DateTime?
  endTime           DateTime?
  isPublished       Boolean        @default(false)
  publishedAt       DateTime?
  resultReleaseTime DateTime?
  questionPoolId    String
  questionPool      QuestionPool   @relation(fields: [questionPoolId], references: [id], onDelete: Restrict)
  questions         ExamQuestion[]
  attempts          ExamAttempt[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model Question {
  id             String             @id @default(cuid())
  text           String
  options        String[]
  correctAnswer  String
  difficulty     QuestionDifficulty
  questionPoolId String
  questionPool   QuestionPool       @relation(fields: [questionPoolId], references: [id], onDelete: Restrict)
  examQuestions  ExamQuestion[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([questionPoolId, createdAt])
}

model ExamQuestion {
  id         String   @id @default(cuid())
  examId     String
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  orderIndex Int      @default(0)

  @@unique([examId, questionId])
}

model ExamAttempt {
  id          String    @id @default(cuid())
  examId      String
  exam        Exam      @relation(fields: [examId], references: [id], onDelete: Restrict)
  studentId   Int
  student     User      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  status      String    @default("SUBMITTED")
  score       Int       @default(0)
  totalMarks  Int       @default(0)
  answers     Json?
  startedAt   DateTime  @default(now())
  submittedAt DateTime?

  @@index([examId, studentId])
}
