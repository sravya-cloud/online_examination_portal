PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/exam_portal
# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
# Optional: restrict CORS to the client origin, e.g. http://localhost:5173
CORS_ORIGIN=
# Password given to the demo accounts created by `npm run seed`
SEED_PASSWORD=
